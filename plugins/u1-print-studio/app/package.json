{
  "name": "u1-print-studio-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file --config=/dev/null run build:server && bun --env-file=../../../.env run dist/server.js",
    "dashboard": "bun --no-env-file --config=/dev/null run build:server && U1_STATUS_DASHBOARD=1 PORT=8788 bun --env-file=../../../.env run dist/server.js",
    "dashboard:tailscale": "bun --no-env-file --config=/dev/null run build:server && U1_STATUS_DASHBOARD=1 U1_DASHBOARD_TAILSCALE_PORT=8444 PORT=8788 bun --env-file=../../../.env run dist/server.js",
    "start": "bun --env-file=../../../.env run dist/server.js",
    "stdio": "bun --env-file=../../../.env run src/entrypoints/stdio-main.ts",
    "bundle": "bun --no-env-file --config=/dev/null build src/entrypoints/stdio-main.ts --target=bun --outdir=dist --entry-naming=stdio.js --asset-naming=[name].[ext]",
    "bundle:server": "bun --no-env-file --config=/dev/null run build:server",
    "bundle:runtime": "bun --no-env-file --config=/dev/null run scripts/build-runtime.ts",
    "setup": "bun run src/entrypoints/cli.ts setup",
    "doctor": "bun run src/entrypoints/cli.ts doctor",
    "check": "tsc --noEmit -p tsconfig.server.json",
    "test": "bun --no-env-file --config=/dev/null run test:server",
    "ui:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun --no-env-file --config=/dev/null run scripts/check-components.ts",
    "ui:test": "vitest run",
    "ui:build": "bun --no-env-file --config=/dev/null run scripts/build-observation-lab.ts && bun --no-env-file --config=/dev/null run package:private-lab",
    "ui:verify": "bun --no-env-file --config=/dev/null run verify:private-lab",
    "ui:build:embed": "bun --no-env-file --config=/dev/null run build:embed",
    "ui:test:browser": "bun --no-env-file --config=/dev/null run test:browser",
    "build:live-heads": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --heads",
    "verify:live-heads": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --heads --check",
    "build:live-camera": "bun --no-env-file --config=/dev/null run scripts/build-live-camera.ts",
    "verify:live-camera": "bun --no-env-file --config=/dev/null run scripts/build-live-camera.ts --check",
    "build:mcp-observation": "bun --no-env-file --config=/dev/null run scripts/build-mcp-observation.ts",
    "verify:mcp-observation": "bun --no-env-file --config=/dev/null run scripts/build-mcp-observation.ts --check",
    "build:mcp-composable-lab": "bun --no-env-file --config=/dev/null run scripts/build-mcp-composable-lab.ts",
    "verify:mcp-composable-lab": "bun --no-env-file --config=/dev/null run scripts/build-mcp-composable-lab.ts --check",
    "build:mcp-camera": "bun --no-env-file --config=/dev/null run scripts/build-live-camera.ts --mcp",
    "verify:mcp-camera": "bun --no-env-file --config=/dev/null run scripts/build-live-camera.ts --mcp --check",
    "preview": "vite preview",
    "build:bed-mesh-lab": "bun --no-env-file --config=/dev/null run scripts/build-bed-mesh-lab.ts",
    "package:private-lab": "bun --no-env-file --config=/dev/null run scripts/build-bed-mesh-lab.ts && bun --no-env-file --config=/dev/null run scripts/build-camera-lab.ts && bun --no-env-file --config=/dev/null run scripts/package-private-lab.ts",
    "verify:private-lab": "bun --no-env-file --config=/dev/null run scripts/build-observation-lab.ts && bun --no-env-file --config=/dev/null run scripts/build-bed-mesh-lab.ts && bun --no-env-file --config=/dev/null run scripts/build-camera-lab.ts && bun --no-env-file --config=/dev/null run scripts/package-private-lab.ts --check",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:live-fans": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts",
    "verify:live-fans": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --check",
    "build:live-thermals": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --thermals",
    "verify:live-thermals": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --thermals --check",
    "build:live-queue": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --queue",
    "verify:live-queue": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --queue --check",
    "test:browser": "bun --no-env-file --config=/dev/null run build && bun --no-env-file --config=/dev/null run build:composable-preview && bun --no-env-file --config=/dev/null run scripts/build-state-harness.ts && bun --no-env-file --config=/dev/null run scripts/build-camera-harness.ts && playwright test && playwright test --config playwright.composable.config.ts && playwright test --config playwright.mcp.config.ts",
    "build:server": "bun --no-env-file --config=/dev/null run scripts/build-server.ts",
    "build": "vite build",
    "test:server": "bun --no-env-file --config=/dev/null run build && bun --no-env-file --config=/dev/null test tests/server",
    "test:mcp-widgets": "playwright test --config playwright.mcp.config.ts",
    "build:live-progress": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --progress",
    "verify:live-progress": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --progress --check",
    "build:live-jobs": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --jobs",
    "verify:live-jobs": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --jobs --check",
    "build:live-job_history": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --job_history",
    "verify:live-job_history": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --job_history --check",
    "build:live-overview": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --overview",
    "verify:live-overview": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --overview --check",
    "build:live-bed_mesh": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --bed_mesh",
    "verify:live-bed_mesh": "bun --no-env-file --config=/dev/null run scripts/build-live-fans.ts --bed_mesh --check",
    "build:composable-preview": "U1_COMPOSABLE_KIT_OUT=build-kit-composable-v2 bun --no-env-file --config=/dev/null run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "13.3.2",
    "jose": "6.2.10",
    "three": "0.185.1",
    "werift": "0.24.4",
    "zod": "3.25.76",
    "lucide-svelte": "0.544.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "typescript": "5.9.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "26.1.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "@sveltejs/adapter-node": "5.5.7"
  },
  "packageManager": "bun@1.4.2"
}

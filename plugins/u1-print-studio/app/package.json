{
  "name": "u1-print-studio-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../../.env --watch src/server.ts",
    "start": "bun --env-file=../../../.env run src/server.ts",
    "stdio": "bun --env-file=../../../.env run src/stdio.ts",
    "bundle": "bun build src/stdio.ts --target=bun --outfile=dist/stdio.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}

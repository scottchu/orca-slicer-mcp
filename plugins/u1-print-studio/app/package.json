{
  "name": "u1-print-studio-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:server && bun --env-file=../../../.env run dist/server.js",
    "dashboard": "bun run build:server && U1_STATUS_DASHBOARD=1 PORT=8788 bun --env-file=../../../.env run dist/server.js",
    "dashboard:tailscale": "bun run build:server && U1_STATUS_DASHBOARD=1 U1_DASHBOARD_TAILSCALE_PORT=8444 PORT=8788 bun --env-file=../../../.env run dist/server.js",
    "start": "bun --env-file=../../../.env run dist/server.js",
    "stdio": "bun --env-file=../../../.env run src/entrypoints/stdio-main.ts",
    "bundle": "bun build src/entrypoints/stdio-main.ts --target=bun --outdir=dist --entry-naming=stdio.js --asset-naming=[name].[ext]",
    "bundle:server": "bun run build:server",
    "bundle:runtime": "bun run scripts/build-runtime.ts",
    "bundle:widget-vendor": "bun run scripts/build-widget-vendor.ts",
    "setup": "bun run src/entrypoints/cli.ts setup",
    "doctor": "bun run src/entrypoints/cli.ts doctor",
    "check": "tsc --noEmit -p tsconfig.server.json",
    "test": "bun run test:server",
    "ui:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run scripts/check-components.ts",
    "ui:test": "vitest run",
    "ui:build": "bun run scripts/build-observation-lab.ts && bun run package:private-lab",
    "ui:verify": "bun run verify:private-lab",
    "ui:build:embed": "bun run build:embed",
    "ui:test:browser": "bun run test:browser",
    "build:live-heads": "bun run scripts/build-live-fans.ts --heads",
    "verify:live-heads": "bun run scripts/build-live-fans.ts --heads --check",
    "build:live-camera": "bun run scripts/build-live-camera.ts",
    "verify:live-camera": "bun run scripts/build-live-camera.ts --check",
    "preview": "vite preview",
    "build:bed-mesh-lab": "bun run scripts/build-bed-mesh-lab.ts",
    "package:private-lab": "bun run scripts/build-bed-mesh-lab.ts && bun run scripts/build-camera-lab.ts && bun run scripts/package-private-lab.ts",
    "verify:private-lab": "bun run scripts/build-observation-lab.ts && bun run scripts/build-bed-mesh-lab.ts && bun run scripts/build-camera-lab.ts && bun run scripts/package-private-lab.ts --check",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:live-fans": "bun run scripts/build-live-fans.ts",
    "verify:live-fans": "bun run scripts/build-live-fans.ts --check",
    "build:live-thermals": "bun run scripts/build-live-fans.ts --thermals",
    "verify:live-thermals": "bun run scripts/build-live-fans.ts --thermals --check",
    "build:live-queue": "bun run scripts/build-live-fans.ts --queue",
    "verify:live-queue": "bun run scripts/build-live-fans.ts --queue --check",
    "test:browser": "bun run build && bun run scripts/build-state-harness.ts && bun run scripts/build-camera-harness.ts && playwright test",
    "build:server": "bun run scripts/build-server.ts",
    "build": "vite build",
    "test:server": "bun run build && bun test tests/server"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "13.3.2",
    "jose": "6.2.10",
    "three": "0.185.1",
    "werift": "0.24.4",
    "zod": "3.25.76",
    "lucide-svelte": "0.544.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "typescript": "5.9.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "26.1.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "@sveltejs/adapter-node": "5.5.7"
  },
  "packageManager": "bun@1.4.0"
}

{
  "name": "u1-print-studio-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../../.env --watch src/server.ts",
    "dashboard": "U1_STATUS_DASHBOARD=1 PORT=8788 bun --env-file=../../../.env --watch src/server.ts",
    "dashboard:tailscale": "U1_STATUS_DASHBOARD=1 U1_DASHBOARD_TAILSCALE_PORT=8444 PORT=8788 bun --env-file=../../../.env --watch src/server.ts",
    "start": "bun --env-file=../../../.env run src/server.ts",
    "stdio": "bun --env-file=../../../.env run src/stdio-main.ts",
    "bundle": "bun build src/stdio-main.ts --target=bun --outdir=dist --entry-naming=stdio.js --asset-naming=[name].[ext]",
    "bundle:server": "bun build src/server.ts --target=bun --outdir=dist --entry-naming=server.js --asset-naming=[name].[ext]",
    "bundle:runtime": "bun run src/build-runtime.ts",
    "bundle:widget-vendor": "bun run src/build-widget-vendor.ts",
    "setup": "bun run src/cli.ts setup",
    "doctor": "bun run src/cli.ts doctor",
    "check": "tsc --noEmit",
    "test": "bun test src/*.test.ts",
    "ui:check": "bun run --cwd ui check",
    "ui:test": "bun run --cwd ui test",
    "ui:build": "bun run --cwd ui build && bun run --cwd ui package:private-lab",
    "ui:verify": "bun run --cwd ui verify:private-lab",
    "ui:build:embed": "bun run --cwd ui build:embed",
    "ui:test:browser": "bun run --cwd ui test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@simplewebauthn/server": "^13.3.2",
    "jose": "^6.2.10",
    "three": "0.185.1",
    "werift": "0.24.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.3.0",
    "@types/three": "0.185.4",
    "typescript": "^5.9.2"
  }
}

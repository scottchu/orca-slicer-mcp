{
  "name": "u1-print-studio-ui-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build:live-camera": "bun run scripts/build-live-camera.ts",
    "verify:live-camera": "bun run scripts/build-live-camera.ts --check",
    "dev": "vite",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run scripts/check-components.ts",
    "test": "vitest run",
    "build": "vite build",
    "package:private-lab": "bun run scripts/build-camera-lab.ts && bun run scripts/package-private-lab.ts",
    "verify:private-lab": "bun run build && bun run scripts/build-camera-lab.ts && bun run scripts/package-private-lab.ts --check",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:live-fans": "bun run scripts/build-live-fans.ts",
    "verify:live-fans": "bun run scripts/build-live-fans.ts --check",
    "build:live-thermals": "bun run scripts/build-live-fans.ts --thermals",
    "verify:live-thermals": "bun run scripts/build-live-fans.ts --thermals --check",
    "build:live-queue": "bun run scripts/build-live-fans.ts --queue",
    "verify:live-queue": "bun run scripts/build-live-fans.ts --queue --check",
    "test:browser": "bun run scripts/build-state-harness.ts && bun run scripts/build-camera-harness.ts && playwright test"
  },
  "dependencies": {
    "lucide-svelte": "^0.544.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.2.8",
    "@types/three": "0.185.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.10",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
